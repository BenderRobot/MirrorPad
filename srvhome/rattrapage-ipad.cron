# Si l'iPad était éteint au moment d'une release, il est mis à jour dès qu'il revient (vérif. toutes les 2 min).
# Installation : crontab -e   puis coller la ligne ci-dessous
*/2 * * * * cd $HOME/projets/mirrrpad/actions-runner/_work/MirrorPad/MirrorPad && python3 ipad/deploy.py --if-needed >> $HOME/.mirrorpad/rattrapage.log 2>&1
